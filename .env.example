NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only -- bypasses RLS, must never carry a NEXT_PUBLIC_ prefix.
# Used by scripts/seed.ts and by app/api/auth/login (the sign-in rate limiter,
# whose counters must not be client-writable). Required in the deployed
# environment too, or the limiter silently degrades.
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase CLI only (not Next.js runtime vars) ---
# supabase/config.toml reads these via env(). `supabase start` and
# `supabase config push` both need them exported or present here.
# Local value below; when pushing config to a deployed project, export the
# deployed origin instead so email links point at the right host.
SUPABASE_AUTH_SITE_URL=http://127.0.0.1:3000
# Resend API key for custom SMTP. Required to override email templates --
# Supabase rejects template changes while the built-in provider is active.
RESEND_API_KEY=
